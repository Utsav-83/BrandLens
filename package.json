{
  "name": "brandlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/audit.test.ts tests/auth.test.ts tests/inclusive-language.test.ts",
    "test:coverage": "vitest run tests/unit tests/audit.test.ts tests/auth.test.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "jose": "^6.2.13",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "pg": "^8.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.2",
    "unpdf": "^1.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "postcss": "^8.5.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
