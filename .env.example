# PostgreSQL connection string (pooled, for application runtime - e.g. Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct PostgreSQL connection string (non-pooled, for migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Dedicated test database (optional; test suite runs pure logic tests without this)
TEST_DATABASE_URL=""

# Authentication secret for JWT (HS256)
JWT_SECRET="brandlens-super-secret-hackathon-key-32chars"

# Demo Mode: gates /api/auth/demo/[role] and one-click demo login buttons
DEMO_MODE="true"

# LLM Configuration (never hardcode models)
# Provider options: gemini | openai | anthropic | groq | none
LLM_PROVIDER="none"
LLM_MODEL=""
LLM_API_KEY=""
